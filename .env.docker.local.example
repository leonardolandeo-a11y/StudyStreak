# Used ONLY by: docker compose --env-file .env.docker.local -f compose.local.yaml ...
# Copy to .env.docker.local (ignored by Git). Never copy production credentials.
LOCAL_LAN_IP=192.168.1.100
LOCAL_API_PORT=8080
LOCAL_DB_PORT=5433
LOCAL_DB_NAME=studystreak_local
LOCAL_DB_USER=studystreak_local
# For a NEW database, select a NEW unused volume, project and ports together.
# Never change an existing database's credentials or initialize it without approval.
LOCAL_DB_VOLUME=studystreak_local_postgres_data_v1
# Bootstrap only a NEW, explicitly selected database. Once initialized, use
# validate / never / false to prevent DDL or ledger migration on normal starts.
LOCAL_DB_DDL_AUTO=update
LOCAL_AUTH_SCHEMA_INIT=always
LOCAL_LEDGER_SCHEMA_INIT=true
# Generate a local password: openssl rand -hex 24
LOCAL_DB_PASSWORD=replace_with_generated_local_password
# Generate a Base64 signing key: openssl rand -base64 32
LOCAL_JWT_SECRET=replace_with_generated_base64_key
# Optional, empty by default; authentication does not require Google Books.
LOCAL_GOOGLE_BOOKS_API_KEY=
