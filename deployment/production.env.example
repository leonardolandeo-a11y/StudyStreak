# EXAMPLE ONLY. Do not deploy with placeholder values. Do not commit real credentials.
SPRING_DATASOURCE_URL=jdbc:postgresql://your-rds-host:5432/studystreak?sslmode=require
SPRING_DATASOURCE_USERNAME=your_database_user
SPRING_DATASOURCE_PASSWORD=replace_with_secure_password
JWT_SECRET=replace_with_high_entropy_secret
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000
MAIL_USERNAME=your_mail_user
MAIL_PASSWORD=replace_with_mail_app_password
GOOGLE_BOOKS_API_KEY=replace_with_google_books_key
APP_CORS_ALLOWED_ORIGINS=https://your-site.vercel.app
SERVER_PORT=8080
# Production-only safeguards. Use validate only after the database schema is installed.
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
# Mount a persistent path or volume when serving profile images from containers.
PROFILE_IMAGE_DIRECTORY=/var/lib/studystreak/profile-images
# Enable the optional native room media only when LiveKit is provisioned.
LIVEKIT_ENABLED=false
LIVEKIT_URL=
LIVEKIT_INTERNAL_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
