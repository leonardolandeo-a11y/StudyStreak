              "pm.collectionVariables.set(\"dailyRecordId\", String(j.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Send TrackingLink A to B",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/tracking-links/{{userBId}}",
        "description": "Usuario A invita a B a hacer seguimiento.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
              "const j = pm.response.json();",
              "pm.collectionVariables.set(\"trackingId\", String(j.id));",
              "pm.test(\"TrackingLink PENDING\", function () { pm.expect(j.status).to.eql(\"PENDING\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - User B Accepts TrackingLink",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/tracking-links/{{trackingId}}/status",
        "description": "Usuario B acepta la relación.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenB}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ACCEPTED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "const j = pm.response.json();",
              "pm.test(\"TrackingLink ACCEPTED\", function () { pm.expect(j.status).to.eql(\"ACCEPTED\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - User B Validates DailyRecord",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/goals/{{goalId}}/daily-records/{{dailyRecordId}}/validation",
        "description": "Usuario B valida el progreso de A.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenB}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"approved\": true,\n  \"comment\": \"Validado correctamente desde el deployment AWS.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
