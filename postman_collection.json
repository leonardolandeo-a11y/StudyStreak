    },
    {
      "key": "recordDate",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Register User A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/register",
        "description": "Crea el primer usuario de prueba y guarda su id.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{userAUsername}}\",\n  \"email\": \"{{userAEmail}}\",\n  \"password\": \"{{password}}\",\n  \"timeZone\": \"America/Lima\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const yesterday = new Date(Date.now() - 86400000).toISOString().slice(0,10);",
              "pm.collectionVariables.set(\"recordDate\", yesterday);",
              "[\"tokenA\",\"refreshTokenA\",\"tokenB\",\"userAId\",\"userBId\",\"goalId\",\"dailyRecordId\",\"trackingId\",\"validationId\"].forEach(k => pm.collectionVariables.unset(k));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
              "const j = pm.response.json();",
              "pm.collectionVariables.set(\"userAId\", String(j.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Login User A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/login",
        "description": "Obtiene access y refresh token del usuario A.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{userAUsername}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "const j = pm.response.json();",
              "pm.collectionVariables.set(\"tokenA\", j.token);",
              "pm.collectionVariables.set(\"refreshTokenA\", j.refreshToken);",
              "pm.test(\"Access token recibido\", function () { pm.expect(j.token).to.be.a(\"string\"); });",
              "pm.test(\"Refresh token recibido\", function () { pm.expect(j.refreshToken).to.be.a(\"string\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Refresh Token A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/refresh",
        "description": "Demuestra el flujo de refresh token.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshTokenA}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "const j = pm.response.json();",
              "pm.collectionVariables.set(\"tokenA\", j.token);",
              "pm.collectionVariables.set(\"refreshTokenA\", j.refreshToken);"
            ]
          }
        }
      ]
    },
    {
