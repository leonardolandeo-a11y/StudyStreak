        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"{{recordDate}}\",\n  \"note\": \"Sesión de estudio creada desde Postman en AWS.\",\n  \"evidence\": \"https://example.com/evidence/aws-smoke-test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
