              "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
              "const j = pm.response.json();",
              "pm.collectionVariables.set(\"validationId\", String(j.id));",
              "pm.test(\"Validation approved\", function () { pm.expect(j.approved).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Get Streak",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/goals/{{goalId}}/streak",
        "description": "Usuario A consulta la racha calculada.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "const j = pm.response.json();",
              "pm.test(\"Streak response\", function () { pm.expect(j).to.have.property(\"currentStreak\"); pm.expect(j).to.have.property(\"bestStreak\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - List User B Notifications",
      "request": {
